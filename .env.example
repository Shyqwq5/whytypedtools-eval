# Fine-grained personal access token scoped to the sandbox repo only.
# Permissions: Issues (read/write), Metadata (read).
GITHUB_TOKEN=github_pat_xxx

# The sandbox repo the tools and agent act on (owner/name).
SANDBOX_REPO=your-user/whytypedtools-sandbox

# Cohere API key for the test agent (step 3). Only needed to run the agent.
COHERE_API_KEY=

# Optional: Cohere model for the agent. Defaults to command-a-plus-05-2026.
COHERE_MODEL=
