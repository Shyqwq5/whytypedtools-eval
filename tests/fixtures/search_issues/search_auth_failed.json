{
  "scenario": "search_auth_failed",
  "tool": "search_issues",
  "args": {
    "query": "rate limit"
  },
  "page_size": 50,
  "auth": "invalid",
  "repo_suffix": "",
  "expect": "auth_failed",
  "source": "recorded",
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/search/issues",
        "params": {
          "q": "repo:sandbox-owner/whytypedtools-sandbox is:issue rate limit",
          "per_page": "10"
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "content-type": "application/json; charset=utf-8"
        },
        "json": {
          "message": "Bad credentials"
        }
      }
    }
  ],
  "result": {
    "ok": false,
    "error": {
      "type": "auth_failed",
      "message": "GitHub rejected the credentials. This cannot be fixed by retrying; the operator must update the token.",
      "retryable": false,
      "retry_after_seconds": null
    }
  }
}
